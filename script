--==================================================
-- AUTOMATIC ENTITY DISCOVERY (DELTA FIX)
--==================================================

for _, model in ipairs(CollectionService:GetTagged(Config.MobTag)) do
    registerMob(model)
end

for _, object in ipairs(CollectionService:GetTagged(Config.ItemTag)) do
    registerItem(object)
end

CollectionService:GetInstanceAddedSignal(Config.MobTag)
    :Connect(registerMob)

CollectionService:GetInstanceRemovedSignal(Config.MobTag)
    :Connect(removeMob)

CollectionService:GetInstanceAddedSignal(Config.ItemTag)
    :Connect(registerItem)

CollectionService:GetInstanceRemovedSignal(Config.ItemTag)
    :Connect(function(object)
        local record = Items[object]

        if record then
            if record.ancestryConnection then
                record.ancestryConnection:Disconnect()
            end

            removeItem(record)
            Items[object] = nil
        end
    end)

-- Fallback/Auto-scan workspace for Steal or Die compatibility
task.spawn(function()
    while true do
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                if not isPlayerCharacter(obj) and obj ~= Player.Character then
                    registerMob(obj)
                end
            elseif obj:IsA("Tool") or (obj:IsA("BasePart") and (obj:FindFirstChildOfClass("ProximityPrompt") or obj.Name:lower():find("item") or obj.Name:lower():find("steal") or obj.Name:lower():find("loot"))) then
                registerItem(obj)
            end
        end
        task.wait(2)
    end
end)

--==================================================
-- OPTIMIZED UPDATE LOOP
--==================================================

RunService.Heartbeat:Connect(function(dt)
    Elapsed += dt

    if Elapsed < Config.UpdateInterval then
        return
    end

    Elapsed = 0

    for _, record in pairs(Mobs) do
        refreshMob(record)
    end

    for _, record in pairs(Items) do
        refreshItem(record)
    end

    updateWarnings()
end)

notify("Asteria Hub V2 initialized!")
